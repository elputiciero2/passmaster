# Servidor
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=passmaster_db

# Seguridad JWT
JWT_SECRET=passmaster_jwt_secret_super_seguro_2026_xyz
JWT_EXPIRES_IN=7d

# Secreto para firma criptográfica de Códigos QR
QR_HMAC_SECRET=passmaster_qr_hmac_secret_key_8899aabbcc

# Pasarela de Pagos (Stripe Sandbox)
# Si no se provee STRIPE_SECRET_KEY, el sistema usa el modo MOCK_SANDBOX integrado
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_example

# Poner 1 solo si el backend queda detrás de un proxy propio (nginx); así los límites usan la IP real
# TRUST_PROXY=1
